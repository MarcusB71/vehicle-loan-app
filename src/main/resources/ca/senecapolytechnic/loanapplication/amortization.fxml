<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.senecapolytechnic.loanapplication.controller.AmortizationController">
    <VBox spacing="10" alignment="CENTER" prefWidth="600" prefHeight="400">
        <Label text="Loan Amortization Schedule" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView fx:id="amortizationTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="paymentNoColumn" text="No." prefWidth="50" />
                <TableColumn fx:id="paymentDateColumn" text="Date" prefWidth="100" />
                <TableColumn fx:id="paymentAmountColumn" text="Payment" prefWidth="100" />
                <TableColumn fx:id="interestPaymentColumn" text="Interest" prefWidth="100" />
                <TableColumn fx:id="principalAmountColumn" text="Principal" prefWidth="100" />
                <TableColumn fx:id="remainingBalanceColumn" text="Balance" prefWidth="120" />
            </columns>
        </TableView>

        <Button text="Close" onAction="#handleClose" />
    </VBox>
</AnchorPane>
